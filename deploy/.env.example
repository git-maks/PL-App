# Production settings for deploy/compose.yaml. Copy to deploy/.env (never commit the real file) and fill in.
# Full reference: docs/WDROZENIE.md.

# Public address of the app (goes into QR codes and invites, used for the Origin check).
UQ_DOMAIN=uniquest.example.pl
UQ_BASE_URL=https://uniquest.example.pl

# Image to run (published by .github/workflows/image.yml). Pin a version tag in production.
UQ_IMAGE=ghcr.io/git-maks/pl-app:latest

# Behind Caddy over HTTPS.
UQ_COOKIE_SECURE=true
UQ_TRUST_PROXY=true
UQ_DEV_LOGIN_CODES=false

# Database password (generate e.g. with: openssl rand -base64 24).
POSTGRES_PASSWORD=change-me

# E-mail login codes.
UQ_SMTP_HOST=smtp.example.pl
UQ_SMTP_PORT=587
UQ_SMTP_USER=
UQ_SMTP_PASSWORD=
UQ_SMTP_FROM=UniQuest <uniquest@example.pl>

# Web Push (generate with: docker compose -f deploy/compose.yaml run --rm app gen-vapid).
UQ_VAPID_PUBLIC=
UQ_VAPID_PRIVATE=
UQ_VAPID_SUBJECT=mailto:uniquest@example.pl
