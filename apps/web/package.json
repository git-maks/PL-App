{
  "name": "@uniquest/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../packages/contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "gen:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@material-symbols/svg-400": "^0.48.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#content/*": "../../content/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "barcode-detector": "^3.2.2"
  }
}
